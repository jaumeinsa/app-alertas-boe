# ─────────────────────────────────────────────────────────────
# Notifikado — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="https://notifikado.com"
NODE_ENV="development"

# Base de datos PostgreSQL (Hostinger VPS / Docker)
# Para docker-compose el host es "db"; en local "localhost".
DATABASE_URL="postgresql://notifikado:notifikado@localhost:5432/notifikado?schema=public"

# Stripe (suscripción 9 €/mes)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=""   # price_xxx del plan 9 €/mes
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=""    # price_xxx del plan anual
NEXT_PUBLIC_STRIPE_PRICE_FAMILY=""    # price_xxx del plan familiar

# Email transaccional (Resend recomendado)
RESEND_API_KEY=""
EMAIL_FROM="Notifikado <avisos@notifikado.com>"

# Notificaciones urgentes (opcional, fase 2)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Ingesta de fuentes
# Cuántos días hacia atrás escanea el "primer escaneo" de un nuevo perfil.
INITIAL_BACKSCAN_DAYS="180"
# User-Agent para las peticiones a las APIs oficiales (buena práctica/cortesía).
INGEST_USER_AGENT="NotifikadoBot/0.1 (+https://notifikado.com)"

# Secreto para firmar la sesión (genera uno con: openssl rand -hex 32)
AUTH_SECRET=""

# Identificador de cimas (/cimas) — opcional
# Clave de la API de Anthropic para el botón «Verificar con IA».
# Sin ella, la página funciona igual pero sin verificación con IA.
ANTHROPIC_API_KEY=""
